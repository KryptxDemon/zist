# ─────────────────────────────────────────────────────────────────────────────
# ZIST mobile — environment configuration
#
# Copy to `.env` and adjust. Every variable must be prefixed with EXPO_PUBLIC_
# to be inlined into the JS bundle by Expo.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend, INCLUDING the /api/v1 prefix.
#   local dev (iOS simulator / web)  -> http://localhost:8000/api/v1
#   Android emulator                 -> http://10.0.2.2:8000/api/v1
#   physical device                  -> http://<your-lan-ip>:8000/api/v1
#   production                       -> https://<your-api-host>/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public TMDb API key used by the dashboard's trending rail (optional — the
# section is hidden when this is not set).
EXPO_PUBLIC_TMDB_API_KEY=
