# Frontend environment variables (placeholders only)
#
# Copy this file to `.env.local` (untracked) and fill in real values during
# development. Do NOT commit secrets.

# Backend API URL used by `apiClient`. In production on Netlify this is the
# path-based proxy (`/api/v1`) defined in `netlify.toml`. Locally you can
# point directly at the FastAPI service.
VITE_API_URL=/api/v1

# Neon Auth endpoint used by `src/lib/neon.ts`. The Neon React components
# (NeonAuthUIProvider, SignedIn, SignedOut, UserButton, etc.) read this URL
# from the bundled client.
#
# Example:
# VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=
